<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chandler Real Estate Team</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="Chandler Real Estate Team - Your trusted Idaho real estate experts. Find homes for sale in Weiser, Payette, and the Treasure Valley. Expert realtors Julie and Bailey Chandler." />
    <meta name="keywords" content="Idaho real estate, Weiser homes for sale, Treasure Valley real estate, Payette homes, Idaho realtor, Julie Chandler, Bailey Chandler, Select Properties LLC" />
    <meta name="author" content="Chandler Real Estate Team" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://chandlerrealestateteam.com/" />
    
    <!-- Default Open Graph / Social Media Preview Tags (will be overridden by page-specific tags) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://chandlerrealestateteam.com/" />
    <meta property="og:title" content="Chandler Real Estate Team - Find Your Dream Property in Idaho" />
    <meta property="og:description" content="Discover beautiful properties in the Treasure Valley with the Chandler Real Estate Team. Your trusted partner for finding the perfect property in Idaho." />
    <meta property="og:image" content="https://chandlerrealestateteam.com/images/Homepage/image_0.JPG" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Chandler Real Estate Team" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://chandlerrealestateteam.com/" />
    <meta name="twitter:title" content="Chandler Real Estate Team - Find Your Dream Home in Idaho" />
    <meta name="twitter:description" content="Discover beautiful properties in the Treasure Valley with the Chandler Real Estate Team." />
    <meta name="twitter:image" content="https://chandlerrealestateteam.com/images/Homepage/image_0.JPG" />
    
    <!-- Geo Tags for Local SEO -->
    <meta name="geo.region" content="US-ID" />
    <meta name="geo.placename" content="Weiser, Idaho" />
    <meta name="geo.position" content="44.2508;-116.9693" />
    <meta name="ICBM" content="44.2508, -116.9693" />
    
    <!-- Page-specific meta tags will be injected here -->
    @await RenderSectionAsync("Head", required: false)
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SCRANKRealEstate.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-0">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i> Chandler Real Estate Team
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Properties">Properties</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="MortgageCalculator">Calculator</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="FAQ">FAQ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <main class="site-main" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer border-top text-muted bg-light">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="text-primary">Chandler Real Estate Team</h5>
                    <p class="small">Your trusted partner for finding the perfect property in Idaho.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Home" asp-action="Properties" class="text-muted">Browse Properties</a></li>
                        <li><a asp-controller="Home" asp-action="MortgageCalculator" class="text-muted">Mortgage Calculator</a></li>
                        <li><a asp-controller="Home" asp-action="FAQ" class="text-muted">FAQ</a></li>
                        <li><a asp-controller="Home" asp-action="About" class="text-muted">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Contact" class="text-muted">Contact</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy" class="text-muted">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Contact Info</h6>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="bi bi-telephone"></i> Julie: (208) 550-1121</li>
                        <li><i class="bi bi-telephone"></i> Bailey: (208) 392-2578</li>
                        <li><i class="bi bi-envelope"></i> julie@@selectpropertiesllc.com</li>
                        <li><i class="bi bi-envelope"></i> bailey@@selectpropertiesllc.com</li>
                        <li><i class="bi bi-geo-alt"></i> Select Properties LLC <br />524 E Seventh St.<br>Weiser, ID 83672</li>
                    </ul>
                </div>
            </div>
            <hr>
            <div class="text-center small">
                &copy; 2026 Chandler Real Estate Team - All Rights Reserved <br />
                Powered by SCRANKSports.com
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
