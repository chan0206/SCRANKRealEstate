@model SCRANKRealEstate.Models.Property
@{
    ViewData["Title"] = $"{Model.Address} - Property Details";
}

@section Head {
    <!-- Open Graph / Social Media Preview Tags for this specific property -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://chandlerrealestateteam.com/Home/PropertyDetails/@Model.Id" />
    <meta property="og:title" content="@Model.Address - $@Model.Price.ToString("N0")" />
    <meta property="og:description" content="@Model.Bedrooms BD | @Model.Bathrooms BA | @Model.SquareFeet SF | @Model.City, @Model.State - @Model.Description" />
    <meta property="og:image" content="https://chandlerrealestateteam.com@(Model.ImageUrls.FirstOrDefault() ?? "/images/default-house.jpg")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    
    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Model.Address - $@Model.Price.ToString("N0")" />
    <meta name="twitter:description" content="@Model.Bedrooms BD | @Model.Bathrooms BA | @Model.SquareFeet SF" />
    <meta name="twitter:image" content="https://chandlerrealestateteam.com@(Model.ImageUrls.FirstOrDefault() ?? "/images/default-house.jpg")" />
}

<!-- Rest of your PropertyDetails view content remains the same -->
<div class="container py-5">
    <div class="row">
        <!-- Property Images Gallery -->
        <div class="col-lg-8 mb-4">
            <!-- Main Carousel - Compact Version -->
            <div id="propertyCarousel" class="carousel slide property-detail-carousel-compact" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    @for (int i = 0; i < Model.ImageUrls.Count; i++)
                    {
                        <button type="button" data-bs-target="#propertyCarousel" data-bs-slide-to="@i" 
                                class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" 
                                aria-label="Slide @(i + 1)"></button>
                    }
                </div>
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.ImageUrls.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@Model.ImageUrls[i]" class="d-block w-100" alt="@Model.Address - Image @(i + 1)"
                                 onerror="this.src='https://via.placeholder.com/800x600?text=Property+Image'">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>

            <!-- Thumbnail Gallery - Compact -->
            <div class="property-thumbnails-compact">
                <div class="thumbnail-scroll">
                    @for (int i = 0; i < Model.ImageUrls.Count; i++)
                    {
                        var index = i;
                        <img src="@Model.ImageUrls[i]" 
                             class="property-thumbnail-compact @(i == 0 ? "active" : "")" 
                             alt="Thumbnail @(i + 1)"
                             onclick="changeImage(@index)"
                             onerror="this.src='https://via.placeholder.com/90x68?text=Thumb'">
                    }
                </div>
            </div>
        </div>

        <!-- Property Details -->
        <div class="col-lg-4">
            <div class="card shadow-sm sticky-top" style="top: 80px;">
                <div class="card-body">
                    <h2 class="property-detail-price mb-3">$@Model.Price.ToString("N0")</h2>
                    
                    <h4 class="mb-2">@Model.Address</h4>
                    <p class="text-muted mb-4">@Model.City, @Model.State @Model.ZipCode</p>

                    <div class="property-quick-stats mb-4">
                        <p class="mb-2">
                            <i class="bi bi-door-open"></i>
                            <strong>@Model.Bedrooms</strong> Bedrooms
                        </p>
                        <p class="mb-2">
                            <i class="bi bi-droplet"></i>
                            <strong>@Model.Bathrooms</strong> Bathrooms
                        </p>
                        <p class="mb-2">
                            <i class="bi bi-rulers"></i>
                            <strong>@Model.SquareFeet.ToString("N0")</strong> Sq Ft
                        </p>
                        <p class="mb-2">
                            <i class="bi bi-pin-map"></i>
                            <strong>@Model.Acres.ToString()</strong> Acres
                        </p>
                        <p class="mb-2">
                            <i class="bi bi-house"></i>
                            <strong>@Model.PropertyType</strong>
                        </p>
                        <p class="mb-0">
                            <i class="bi bi-calendar-check"></i>
                            Listed: <strong>@Model.ListedDate.ToString("MMM dd, yyyy")</strong>
                        </p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Status))
                    {
                        <div class="alert alert-info mb-4">
                            <strong>Status:</strong> @Model.Status
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <a asp-controller="Home" asp-action="Contact" class="btn btn-primary btn-lg">
                            <i class="bi bi-envelope"></i> Contact Agent
                        </a>
                        <button class="btn btn-outline-primary" onclick="window.print()">
                            <i class="bi bi-printer"></i> Print Details
                        </button>
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Listings
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Property Description -->
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <div class="row mt-4">
            <div class="col-lg-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h4 class="mb-3"><i class="bi bi-card-text text-primary"></i> Property Description</h4>
                        <p class="lead">@Model.Description</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
    // Carousel thumbnail navigation
    function changeImage(index) {
        const carousel = new bootstrap.Carousel(document.getElementById('propertyCarousel'));
        carousel.to(index);
        
        // Update active thumbnail
        document.querySelectorAll('.property-thumbnail-compact').forEach((thumb, i) => {
            if (i === index) {
                thumb.classList.add('active');
            } else {
                thumb.classList.remove('active');
            }
        });
    }

    // Update active thumbnail when carousel changes
    document.getElementById('propertyCarousel').addEventListener('slide.bs.carousel', function(e) {
        document.querySelectorAll('.property-thumbnail-compact').forEach((thumb, i) => {
            if (i === e.to) {
                thumb.classList.add('active');
            } else {
                thumb.classList.remove('active');
            }
        });
    });
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.0/font/bootstrap-icons.css">