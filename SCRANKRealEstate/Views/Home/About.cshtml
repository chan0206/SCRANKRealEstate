@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">
    <div class="row mb-5">
        <div class="col-lg-12 text-center">
            <h1 class="display-5 mb-3">About Chandler Real Estate</h1>
            <p class="lead">Your trusted partner in Idaho real estate since 2010</p>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-lg-6 mb-4">
            <img src="/images/about-office.jpg" alt="Our Office" class="img-fluid rounded" onerror="this.src='https://via.placeholder.com/600x400?text=Our+Office'">
        </div>
        <div class="col-lg-6">
            <h2 class="mb-4">Our Story</h2>
            <p>Chandler Real Estate was founded with a simple mission: to help families find their perfect home in beautiful Idaho. With over 15 years of experience in the local market, we've helped thousands of clients buy, sell, and invest in Idaho properties.</p>
            <p>Our team of dedicated real estate professionals brings extensive knowledge of Idaho's diverse communities, from the vibrant city life of Boise to the serene mountain towns of Sun Valley and everything in between.</p>
            <p>We pride ourselves on providing personalized service, honest advice, and unwavering commitment to our clients' success. Whether you're a first-time homebuyer or an experienced investor, we're here to guide you every step of the way.</p>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-lg-12">
            <h2 class="text-center mb-5">Our Values</h2>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-shield-check text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h4>Integrity</h4>
                    <p>We operate with complete transparency and honesty in all our dealings.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-star text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h4>Excellence</h4>
                    <p>We strive for excellence in every aspect of our service delivery.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-heart text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h4>Community</h4>
                    <p>We're committed to giving back and supporting our Idaho communities.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card bg-primary text-white">
                <div class="card-body p-5 text-center">
                    <h3 class="mb-3">Ready to Find Your Dream Home?</h3>
                    <p class="mb-4">Let our experienced team help you navigate Idaho's real estate market.</p>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-light btn-lg">Contact Us Today</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}