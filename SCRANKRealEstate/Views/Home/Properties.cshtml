@model List<SCRANKRealEstate.Models.Property>
@{
    ViewData["Title"] = "Properties";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-lg-12">
            <h1 class="display-5 mb-3">Available Properties</h1>
            <p class="lead">Browse our complete collection of homes across Idaho</p>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <form asp-controller="Home" asp-action="Properties" method="get">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">City</label>
                                <input type="text" class="form-control" name="city" placeholder="Enter city">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Property Type</label>
                                <select class="form-select" name="propertyType">
                                    <option value="">All Types</option>
                                    <option value="Single Family">Single Family</option>
                                    <option value="Condo">Condo</option>
                                    <option value="Townhouse">Townhouse</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Min Price</label>
                                <input type="number" class="form-control" name="minPrice" placeholder="$0">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Max Price</label>
                                <input type="number" class="form-control" name="maxPrice" placeholder="Any">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">&nbsp;</label>
                                <button type="submit" class="btn btn-primary w-100">Filter</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Property Grid -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var property in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="property-card">
                        <div class="property-image">
                            <img src="/images/default-house.jpg" alt="@property.Address">
                            @if (property.Status == "Pending")
                            {
                                <span class="property-badge badge-pending">Pending</span>
                            }
                            else if (property.Status == "Sold")
                            {
                                <span class="property-badge badge-sold">Sold</span>
                            }
                            else if (property.IsFeatured)
                            {
                                <span class="property-badge badge-featured">Featured</span>
                            }
                        </div>
                        <div class="property-details">
                            <div class="property-price">$@property.Price.ToString("N0")</div>
                            <h5 class="property-address">@property.Address</h5>
                            <p class="property-location">@property.City, @property.State @property.ZipCode</p>
                            <div class="property-features">
                                <span><i class="bi bi-door-closed"></i> @property.Bedrooms BD</span>
                                <span><i class="bi bi-droplet"></i> @property.Bathrooms BA</span>
                                <span><i class="bi bi-arrows-angle-expand"></i> @property.SquareFeet SF</span>
                            </div>
                            <a asp-controller="Home" asp-action="PropertyDetails" asp-route-id="@property.Id" class="btn btn-outline-primary w-100 mt-3">View Details</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">No properties found matching your criteria.</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}