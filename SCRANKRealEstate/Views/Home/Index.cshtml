<!-- Featured Properties -->
<section class="featured-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Featured Properties</h2>
            <p class="section-subtitle">Explore our handpicked selection of premium Idaho homes</p>
        </div>
        
        <div class="row g-4">
            @foreach (var property in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="property-card">
                        <div class="property-image">
                            <img src="/images/default-house.jpg" alt="@property.Address" onerror="this.src='/images/properties/default-house.jpg'">
                            @if (property.Status == "Pending")
                            {
                                <span class="property-badge badge-pending">Pending</span>
                            }
                            else if (property.IsFeatured)
                            {
                                <span class="property-badge badge-featured">Featured</span>
                            }
                        </div>
                        <div class="property-details">
                            <div class="property-price">$@property.Price.ToString("N0")</div>
                            <h5 class="property-address">@property.Address</h5>
                            <p class="property-location">@property.City, @property.State @property.ZipCode</p>
                            <div class="property-features">
                                <span><i class="bi bi-door-closed"></i> @property.Bedrooms BD</span>
                                <span><i class="bi bi-droplet"></i> @property.Bathrooms BA</span>
                                <span><i class="bi bi-arrows-angle-expand"></i> @property.SquareFeet SF</span>
                            </div>
                            <a asp-controller="Home" asp-action="PropertyDetails" asp-route-id="@property.Id" class="btn btn-outline-primary w-100 mt-3">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div class="text-center mt-5">
            <a asp-controller="Home" asp-action="Properties" class="btn btn-primary btn-lg">View All Properties</a>
        </div>
    </div>
</section>

<!-- Why Choose Us Section -->
<section class="why-us-section py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Why Choose Chandler Real Estate</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-box text-center">
                    <div class="feature-icon">
                        <i class="bi bi-house-heart"></i>
                    </div>
                    <h4>Local Expertise</h4>
                    <p>Deep knowledge of Idaho's real estate market and communities</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-box text-center">
                    <div class="feature-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h4>Best Prices</h4>
                    <p>Competitive pricing and expert negotiation on your behalf</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-box text-center">
                    <div class="feature-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <h4>Personalized Service</h4>
                    <p>Dedicated support throughout your home buying journey</p>
                </div>
            </div>
        </div>
    </div>
</section>

